{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/Abtektas/param-lineage/schema/params.schema.json",
 "title": "param-lineage parameter histories",
 "description": "The states of every PX4 parameter across the tracked releases (data/params.json), built from the snapshots and the curated facts; see docs/DESIGN.md.",
 "type": "object",
 "required": ["format", "parameters"],
 "additionalProperties": false,
 "properties": {
  "format": {"const": 1, "description": "Layout of this file. Changes when a field is added, renamed or removed."},
  "parameters": {
   "type": "object",
   "minProperties": 1,
   "propertyNames": {"$ref": "#/$defs/name"},
   "additionalProperties": {"$ref": "#/$defs/history"}
  }
 },
 "$defs": {
  "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 16},
  "tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-(alpha|beta|rc)[0-9]+)?$"},
  "history": {
   "type": "object",
   "description": "The history of one parameter.",
   "required": ["states", "removed", "predecessors"],
   "additionalProperties": false,
   "properties": {
    "states": {
     "type": "array",
     "minItems": 1,
     "description": "Oldest first. A state holds from one tracked tag to another, both included; a new state starts where data/changes reports a change. A gap between states means the releases in between do not have the parameter.",
     "items": {
      "type": "object",
      "required": ["from", "to", "type", "default", "rebootRequired"],
      "additionalProperties": false,
      "properties": {
       "from": {"$ref": "#/$defs/tag"},
       "to": {"$ref": "#/$defs/tag"},
       "type": {"enum": ["Int32", "Float"]},
       "default": {"type": "number"},
       "min": {"type": "number"},
       "max": {"type": "number"},
       "units": {"type": "string"},
       "rebootRequired": {"type": "boolean"},
       "values": {"type": "array", "items": {"type": "object", "required": ["value", "description"], "additionalProperties": false, "properties": {"value": {"type": "number"}, "description": {"type": "string"}}}},
       "bitmask": {"type": "array", "items": {"type": "object", "required": ["index", "description"], "additionalProperties": false, "properties": {"index": {"type": "integer", "description": "As PX4 generates it. PX4 v1.16 to v1.18 give VTQ_IO_REV a bit at index -1."}, "description": {"type": "string"}}}}
      }
     }
    },
    "removed": {
     "type": "array",
     "description": "Each tracked tag that does not have the parameter while the tag before does, with the kind and successors of the curated entry, if any.",
     "items": {
      "type": "object",
      "required": ["in"],
      "additionalProperties": false,
      "properties": {
       "in": {"$ref": "#/$defs/tag"},
       "kind": {"enum": ["migrated", "renamed", "replaced", "fixed", "removed"]},
       "successors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/name"}}
      }
     }
    },
    "predecessors": {
     "type": "array",
     "description": "Removed parameters whose curated entry names this one as a successor.",
     "items": {
      "type": "object",
      "required": ["name", "in", "kind"],
      "additionalProperties": false,
      "properties": {
       "name": {"$ref": "#/$defs/name"},
       "in": {"$ref": "#/$defs/tag"},
       "kind": {"enum": ["migrated", "renamed", "replaced"]}
      }
     }
    }
   }
  }
 }
}
